DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Google Sheets service account. Share each school spreadsheet with this client_email as Editor.
# Option A: split the JSON key into email and private key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account-name@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: use the full JSON key instead of the two variables above.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

APP_SECRET=replace-with-a-long-random-secret

# Optional: use a separate secret for /admin session cookies.
OPERATOR_SESSION_SECRET=

# Optional: bootstrap the main operator password from an env var instead of first-run setup.
OPERATOR_PASSWORD_HASH=

# Optional default for public holiday refresh if not set per school.
# Per-school keys entered in /admin or /s/{school-code}/admin override this value.
PUBLIC_DATA_SERVICE_KEY=
