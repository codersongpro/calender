GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account-name@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GOOGLE_SERVICE_ACCOUNT_JSON can be used instead of the two variables above.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

APP_SECRET=replace-with-a-long-random-secret

# Vercel/serverless deployments should use environment variables as the config store.
# Leave ALLOW_FILE_CONFIG unset on Vercel unless you understand that file writes are not persistent.
# ALLOW_FILE_CONFIG=true
ORG_NAME=
SPREADSHEET_ID=
EDIT_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=
PUBLIC_DATA_SERVICE_KEY=
